tap OCT+
wait 100
expect tempo 121
expect presetcur 9
expect hit0.0.0 0
expect hit0.0.4 0
expect hit0.0.8 0
shot bank_09_blank.png
# wip358: the next empty places take the sound of factory preset (place - 9) mod 8 + 1: 10 = like 2 ... 16 = like 8, 17 = like 1 again
turn PRESET 1
tap OCT+
wait 100
expect presetcur 10
expect tempo 79
expect hit0.0.0 0
turn PRESET 1
tap OCT+
wait 100
expect tempo 122
turn PRESET 1
tap OCT+
wait 100
expect tempo 132
turn PRESET 1
tap OCT+
wait 100
expect tempo 135
turn PRESET 1
tap OCT+
wait 100
expect tempo 114
turn PRESET 1
tap OCT+
wait 100
expect tempo 133
turn PRESET 1
tap OCT+
wait 100
expect presetcur 16
expect tempo 133
turn PRESET 1
tap OCT+
wait 100
