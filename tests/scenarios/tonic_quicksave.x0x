# wip263: FUNC + SAVE = quick save into the loaded place (same number, same name), no question.
wait 300
expect presetcur 0
# nothing loaded since power on: FUNC + SAVE says so and saves nothing, no question opens
key b10 down
tap SAVE
key b10 up
expect svstage -1
expect slotused34 0
# SAVE AS puts the project into the first empty place (3 since wip655: places 3-8 are empty user places; place 3 = flash slot 34, 4 = 35, 5 = 36) first
tap SAVE
tap OCT+
tap OCT+
tap OCT+
expect presetcur 3
expect slotused34 1
# a change of our own (track 1, step 9: accent and fill), then FUNC + SAVE keeps it in place 3 without any question
tapkey b1
key w8 down
tapkey b8
tapkey b9
key w8 up
expect vacc0.1.8 1
expect vfill0.1.8 1
key b10 down
tap SAVE
key b10 up
expect svstage -1
expect presetcur 3
# a used place asks OVERWRITE SLOT?: OCT- = EXIT (nothing saved), again + OCT+ = YES
shot qsave_ask.png
tap OCT-
expect svstage -1
key b10 down
tap SAVE
key b10 up
tap OCT+
# go to place 4 (empty: no steps), come back to 3: the change is there
turn PRESET 1
tap OCT+
wait 100
expect presetcur 4
expect vacc0.1.8 0
turn PRESET -1
tap OCT+
wait 100
expect presetcur 3
expect vacc0.1.8 1
expect vfill0.1.8 1
# place 4 is empty: FUNC + SAVE saves at once (no name screens, no question), named UNTITLED 01 (wip308)
turn PRESET 1
tap OCT+
wait 100
expect presetcur 4
expect slotused35 0
expect slotun35 0
key b10 down
tap SAVE
key b10 up
expect svstage -1
expect slotused35 1
expect slotun35 1
expect presetcur 4
turn PRESET -1
tap OCT+
wait 100
expect presetcur 3
# wip286: while playing it works too (no STOP FIRST): a used place asks only OVERWRITE, OCT- = no (menu closes, nothing saved), OCT+ saves and the playing goes on
tap PLAY
wait 200
expect playing 1
tapkey b1
key w9 down
tapkey b8
key w9 up
key b10 down
tap SAVE
key b10 up
expect svstage -1
tap OCT-
expect playing 1
tapkey b1
key b10 down
tap SAVE
key b10 up
tap OCT+
expect dirty 0
expect playing 1
tap PLAY
wait 300
# an empty place while playing: saved at once, named UNTITLED 02 (the next number, wip308), the playing goes on
turn PRESET 1
turn PRESET 1
tap OCT+
wait 100
expect presetcur 5
tap PLAY
wait 200
expect playing 1
key b10 down
tap SAVE
key b10 up
expect svstage -1
expect svstage -1
expect slotused36 1
expect slotun36 2
expect playing 1
tap PLAY
wait 300
turn PRESET -1
turn PRESET -1
tap OCT+
wait 100
expect presetcur 3
# a demo place (1) is saved over itself the same way (its override slot): two steps back from place 3
turn PRESET -1
turn PRESET -1
tap OCT+
wait 100
expect presetcur 1
expect vfill0.1.8 0
tapkey b1
key w8 down
tapkey b9
key w8 up
expect vfill0.1.8 1
key b10 down
tap SAVE
key b10 up
tap OCT+
turn PRESET 1
tap OCT+
wait 100
expect presetcur 2
expect vfill0.1.8 0
turn PRESET -1
tap OCT+
wait 100
expect presetcur 1
expect vfill0.1.8 1
