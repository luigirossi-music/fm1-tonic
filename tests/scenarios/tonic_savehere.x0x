# wip317 / wip708: the normal SAVE = ONE screen, SAVE HERE?: SELECT = the spot, ALGORITHM = the name, OCT+ saves at once, OCT- cancels (CHOOSE SLOT and the slot screen are gone).
wait 300
# nothing loaded: starts at SAVE HERE? (3) on the first empty place; HOME cancels
tap SAVE
expect svstage 3
expect svhere 3
tap HOME
expect svstage -1
# the first save goes into the first empty place (3 since wip655; flash slot 34): one OCT+
tap SAVE
tap OCT+
expect presetcur 3
expect slotused34 1
# a change, then SAVE: SAVE HERE? with place 3
tapkey b1
key w8 down
tapkey b8
tapkey b9
key w8 up
expect vacc0.1.8 1
tap SAVE
expect svstage 3
shot save_here.png
# HOME cancels, nothing saved (dirty stays)
tap HOME
expect svstage -1
expect dirty 1
# OCT+ = YES: saved at once, same place, same name, no more screens
tap SAVE
tap OCT+
expect svstage -1
expect presetcur 3
expect dirty 0
turn PRESET 1
tap OCT+
wait 100
expect presetcur 4
expect vacc0.1.8 0
turn PRESET -1
tap OCT+
wait 100
expect presetcur 3
expect vacc0.1.8 1
# OCT- cancels at once; SELECT moves the spot (1-40, round); ALGORITHM makes another name; OCT+ saves into the spot shown
tap SAVE
tap OCT-
expect svstage -1
tap SAVE
turn SELECT 1
expect svhere 4
turn SELECT -2
expect svhere 2
turn SELECT 1
expect svhere 3
turn ALGO 1
expect svstage 3
expect svhere 3
tap OCT+
wait 200
expect svstage -1
expect presetcur 3
expect slotused34 1
# a demo place (1): SAVE HERE? YES saves over itself (override slot), the place stays 1 (two steps back from place 3)
turn PRESET -1
turn PRESET -1
tap OCT+
wait 100
expect presetcur 1
expect vfill0.1.8 0
tapkey b1
key w8 down
tapkey b9
key w8 up
expect vfill0.1.8 1
tap SAVE
expect svstage 3
tap OCT+
expect presetcur 1
turn PRESET 1
tap OCT+
wait 100
turn PRESET -1
tap OCT+
wait 100
expect presetcur 1
expect vfill0.1.8 1
# while playing: YES works, the playing goes on
tap PLAY
wait 200
tap SAVE
expect svstage 3
tap OCT+
expect svstage -1
expect playing 1
tap PLAY
wait 300
# wip319: SAVE HERE? + ALGORITHM = another place (the loaded one is 1 now); YES saves there, that place is the loaded one after
tap SAVE
expect svstage 3
expect svhere 1
turn SELECT 1
expect svhere 2
expect svstage 3
expect presetcur 1
shot save_here_other.png
turn SELECT -1
turn SELECT -1
expect svhere 30
turn SELECT 1
expect svhere 1
turn SELECT 1
tap OCT+
expect svstage -1
expect presetcur 2
expect dirty 0
# OCT- on SAVE HERE? (another spot chosen) cancels, nothing is saved
tap SAVE
turn SELECT 1
tap OCT-
expect svstage -1
expect presetcur 2
