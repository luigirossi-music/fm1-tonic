# wip284: PERFORM: FUNC with mutes active = every mute goes away (the way FILL clears every solo)
wait 300
tap FX
tap FX
expect view 2
expect fxpage 0
expect mutes 0
# three mutes with the black keys 1, 3, 6
tapkey b0
tapkey b2
tapkey b5
expect mutes 3
shot mutes_three.png
# FUNC: all three come back at once
tapkey b10
expect mutes 0
shot mutes_cleared.png
# FUNC again with no mutes: nothing changes (MUTE mode)
tapkey b10
expect mutes 0
# a solo is not touched by FUNC: SOLO mode (FILL), solo 5, mute 2 in MUTE mode, FUNC clears only the mute
tapkey b9
tapkey b4
expect solo 5
tapkey b10
tapkey b1
expect mutes 1
tapkey b10
expect mutes 0
expect solo 5
# FILL with a solo clears it
tapkey b9
expect solo 0
# the same on the second PERFORM page (ALGO): mute 4 and 7, FUNC clears
turn ALGO 1
tapkey b3
tapkey b6
expect mutes 2
tapkey b10
expect mutes 0
shot mutes_page2.png
tap FX
