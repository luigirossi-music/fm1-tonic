# SAVE opens SAVE AS: three screens (name, name, slot); the project goes into a user slot and the PRESETS knob finds it again.
wait 300
# something of our own in the project: track 2, step 9, with accent and fill
tapkey b1
key w8 down
tapkey b8
tapkey b9
key w8 up
expect vacc0.1.8 1
expect vfill0.1.8 1
# the same in pattern 5 (FUNC + white key 4): SAVE AS keeps patterns 1-8, not only the first (wip152)
key b10 down
tapkey w4
key b10 up
expect ppat0 5
tapkey b1
key w8 down
tapkey b8
tapkey b9
key w8 up
expect vacc4.1.8 1
expect vfill4.1.8 1
expect phit4.1.8 1
# wip317: SAVE = SAVE HERE? when a place is loaded, else CHOOSE SLOT (stage 4); then the slot (2), then the name (1)
# nothing loaded yet: SAVE opens CHOOSE SLOT, ALGORITHM does nothing there, OCT- = EXIT SAVE
tap SAVE
expect svstage 4
shot saveas_choose.png
turn ALGO 1
expect svstage 4
tap OCT-
expect svstage -1
# again: OCT+ to the slot screen, OCT+ to the name, OCT- back to the slot, OCT- back to CHOOSE SLOT, OCT+ to the slot again
tap SAVE
tap OCT+
expect svstage 2
tap OCT+
expect svstage 1
shot saveas_2.png
turn ALGO 1
tap OCT-
expect svstage 2
tap OCT-
expect svstage 4
tap OCT+
expect svstage 2
expect svslot 0
expect svhere 3   # wip343 / wip655: nothing loaded: the first empty place = place 3 (places 3-8 are empty user places since 655)
# ALGORITHM cycles the 30 places, both ways (place 3 + 8 = place 11 = user slot 2)
turn ALGO 8
expect svslot 2
# wip343 / wip654 / wip665: the slot screen covers all 30 places (1-8 too) and cycles round: place 11 - 9 = 2 (a demo place), + 1 = 3,
# - 3 = 30 (round: the last place = the last user slot 21), + 3 = 3 again, + 8 = 11 again
turn ALGO -9
expect svhere 2
turn ALGO 1
expect svhere 3
expect svslot 0
turn ALGO -3
expect svhere 30
expect svslot 21
turn ALGO 3
expect svhere 3
turn ALGO 8
shot saveas_3.png
# OCT+ to the name, OCT- back to the slot, OCT+ again, OCT+ saves
tap OCT+
expect svstage 1
tap OCT-
expect svstage 2
expect svslot 2
tap OCT+
expect slotused2 0
tap OCT+
expect svstage -1
expect slotused2 1
expect presetcur 11
# load another place (place 3 = 8 down: an EMPTY place loads the sound of the test bank's 03 = 150 BPM, no steps), then the knob finds our place 11 again (the knob goes through all 30 places: 8 up)
turn PRESET -1
turn PRESET -1
turn PRESET -1
turn PRESET -1
turn PRESET -1
turn PRESET -1
turn PRESET -1
turn PRESET -1
tap OCT+
expect tempo 150
expect vfill0.1.8 0
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
tap OCT+
expect tempo 125
expect vacc0.1.8 1
expect vfill0.1.8 1
expect presetcur 11
# pattern 5 came back too (wip152: it was lost, only pattern 1 was saved)
expect phit4.1.8 1
expect vacc4.1.8 1
expect vfill4.1.8 1
# a save while playing goes through at once (no STOP FIRST any more): SAVE HERE? first (place 11 is loaded), OCT- = NO, then slot + name
tap PLAY
wait 200
tap SAVE
expect svstage 3
shot saveas_here.png
tap OCT-
expect svstage 4
tap OCT+
# wip343 / wip665: the slot screen starts at the NEXT EMPTY place after the loaded one (11 is loaded: 12), then 12 - 8 = place 4 (an ordinary user place
# since 655, its storage is the override slot 35)
expect svhere 12
turn ALGO -8
expect svhere 4
tap OCT+
expect svstage 1
tap OCT+
expect svstage -1
expect slotused35 1
expect playing 1
tap PLAY
wait 300
# a user preset keeps the first pattern only: load a 12-pattern file (kicks in all 8 kept patterns), then our slot:
# pattern 2 is empty again, pattern 1 is ours
preset build/test_12.tnp
expect preset_rc 0
expect phit1.0.0 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
tap OCT+
wait 100
expect vfill0.1.8 1
expect phit1.0.0 0
expect phit7.0.0 0
