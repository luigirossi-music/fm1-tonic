# wip317: FUNC + HOME = RENAME PROJECT: the name screen alone, saved into the loaded place (1-8 too), OCT- / HOME cancel.
wait 300
# nothing loaded since power on: it says so, no screen opens
key b10 down
tap HOME
key b10 up
expect svstage -1
# SAVE AS puts the project into the first empty place (3 since wip655; flash slot 34)
tap SAVE
tap OCT+
expect presetcur 3
expect slotused34 1
# a change of our own (track 1, step 9: accent and fill)
tapkey b1
key w8 down
tapkey b8
tapkey b9
key w8 up
expect vacc0.1.8 1
# FUNC + HOME opens the name screen alone (stage 1); ALGORITHM makes another name; OCT- cancels: the place keeps its old name
key b10 down
tap HOME
key b10 up
expect svstage 1
shot rename_1.png
turn ALGO 1
tap OCT-
expect svstage -1
expect plmatch2 0
# HOME cancels too
key b10 down
tap HOME
key b10 up
expect svstage 1
tap HOME
expect svstage -1
expect plmatch2 0
# OCT+ saves under the new name into the same place; the place stays 3; the change is saved with it
key b10 down
tap HOME
key b10 up
turn ALGO 1
tap OCT+
expect svstage -1
expect presetcur 3
expect plmatch2 1
expect dirty 0
turn PRESET 1
tap OCT+
wait 100
expect presetcur 4
expect vacc0.1.8 0
turn PRESET -1
tap OCT+
wait 100
expect presetcur 3
expect vacc0.1.8 1
# a demo place (1) is renamed in its override slot: it stays place 1, place 3 keeps its name (two steps back from place 3)
turn PRESET -1
turn PRESET -1
tap OCT+
wait 100
expect presetcur 1
key b10 down
tap HOME
key b10 up
expect svstage 1
turn ALGO 1
tap OCT+
expect svstage -1
expect presetcur 1
expect plmatch0 1
expect plmatch2 0
turn PRESET 1
tap OCT+
wait 100
expect presetcur 2
turn PRESET -1
tap OCT+
wait 100
expect presetcur 1
expect plmatch0 1
# while playing: it works, the playing goes on
tap PLAY
wait 200
expect playing 1
key b10 down
tap HOME
key b10 up
expect svstage 1
turn ALGO 1
tap OCT+
expect svstage -1
expect playing 1
expect plmatch0 1
tap PLAY
wait 300
# the ordinary SAVE after a rename is the normal SAVE again: SAVE HERE? (wip708: ONE screen), OCT- cancels
tap SAVE
expect svstage 3
tap OCT-
expect svstage -1
