# wip608: SONG screen: OCT+ adds a line after the cursor (the same patterns), OCT- deletes the line; K3 REPEAT x1..x16 then LOOP (1.8f2) (the bar plays until stopped)
wait 300
key b10 down
tap SEQ
key b10 up
tap OCT+
tapkey w0
tapkey w1
tap OCT+
expect songlen 2
expect songmode 1
expect view 5
# the cursor is on bar 1 (index 0): OCT+ adds a line after it, a copy of bar 1
tap OCT+
expect songlen 3
expect songbar2.1 1
expect songbar3.1 2
shot songline_1.png
# OCT- deletes the line on the cursor (the new one): back to 2 bars
tap OCT-
expect songlen 2
expect songbar2.1 2
# 1.8f2: K3 up to x16 (repeats - 1 = 15: bits 5-7 = 7 and bit 3), then one more = LOOP (mute bit 4 = 16 only)
turn K3 15 60
expect songbar2.5 232
shot songline_x16.png
turn K3 1 60
expect songbar2.5 16
shot songline_2.png
# the loop flag is not copied by OCT+
tap OCT+
expect songlen 3
expect songbar3.5 0
tap OCT-
expect songlen 2
# the cursor is on END after deleting the last line: back to bar 2
turn K1 -1 100
# PLAY from bar 2 (LOOP): it never moves on
tap PLAY
wait 6000
expect songpos 2
expect songlen 2
tap PLAY
wait 200
# K3 back below LOOP: x16, no loop flag
wait 300
expect playing 0
turn K3 -1 200
expect songbar2.5 232
