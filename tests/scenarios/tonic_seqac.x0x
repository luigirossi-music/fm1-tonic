# wip287: SEQ page: SELECT = the voice (wip699) (8 voices, then AC); on AC the white keys put trigs on the global accent; ARP: SELECT = voice (no AC)
wait 300
tap HOME
tap SEQ
wait 50
expect view 7
expect arp 0
expect sel 0
turn SELECT 1
expect sel 1
turn SELECT -1
turn SELECT -1
expect acsel 1
expect sel 0
shot seq_ac.png
tapkey w0
wait 400
expect gacc0.0 1
expect phit0.0.0 0
tapkey w2
wait 400
expect gacc0.2 1
tapkey w0
wait 400
expect gacc0.0 0
turn SELECT 1
expect acsel 0
expect sel 0
turn SELECT 1
turn SELECT -1
turn SELECT -1
expect acsel 1
tapkey b1
expect acsel 0
expect sel 1
# from AC, ARP: AC is dropped (voice kept), the ARP page has the 8 voices only
turn SELECT -1
turn SELECT -1
expect acsel 1
tap ARP
expect arp 1
expect acsel 0
expect sel 0
turn SELECT -1
expect sel 7
turn SELECT 1
expect sel 0
expect acsel 0
shot arp_knobs.png
