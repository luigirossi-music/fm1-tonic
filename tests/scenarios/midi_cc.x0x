# wip386 (MIDI step S3): the CC TABLE. CC number = parameter, channel = track (CC MODE CHANNELS) or the selected track
# (CC MODE SELECTED, on the Tonic's channel 10 = status B9). CC MODE is OFF by default: nothing moves.
# Table used here: 7 LEVEL (pot 17), 10 PAN (21), 20 OSC WAVE (pot 0, 3 values), 23 OSC DECAY (pot 3), 111 HIGH CUT (25), 112 REVERB SEND (22).
# Hex on the midi line: 7F = 127, 64 = 100, 32 = 50, 40 = 64, 17 = CC 23.
wait 300
expect ccmode 0
param 0 0 3 10
param 0 1 3 10
param 0 2 3 10
# OFF (default): a CC on channel 1 and on the Tonic's channel does nothing and never reaches the queue
midi B0 17 64
midi B9 17 64
wait 100
potget 0 3
expect lastpot 10
expect mq_n 0
# CHANNELS (block of 8 from channel 1): CC 23 on channel 1 = track 1, channel 2 = track 2
ccmode 2 0
midi B0 17 64
wait 100
potget 0 3
expect lastpot 100
midi B1 17 32
wait 100
potget 1 3
expect lastpot 50
potget 0 3
expect lastpot 100
potget 2 3
expect lastpot 10
# the Tonic's channel (10) is outside the block 1-8: nothing in CHANNELS mode; channel 9 neither
midi B9 17 7F
midi B8 17 7F
wait 100
potget 2 3
expect lastpot 10
# LEVEL (CC 7) on channel 3 = track 3, full
midi B2 07 7F
wait 100
potget 2 17
expect lastpot 127
# PAN (CC 10) centre on track 4
midi B3 0A 40
wait 100
potget 3 21
expect lastpot 64
# a 3-way switch (OSC WAVE, CC 20 = hex 14): the range in three, 0 / 1 / 2
midi B0 14 7F
wait 100
potget 0 0
expect lastpot 2
midi B0 14 40
wait 100
potget 0 0
expect lastpot 1
midi B0 14 00
wait 100
potget 0 0
expect lastpot 0
# a CC that is not in the table (CC 1, 64, 120 = hex 01 40 78) changes nothing and costs nothing
midi B0 01 7F
midi B0 40 7F
midi B0 78 00
wait 100
potget 0 3
expect lastpot 100
# SELECTED: the Tonic's channel moves the SELECTED track (track 2 after black key 2); the block does not work any more
ccmode 1 0
tapkey b1
expect sel 1
midi B9 17 20
wait 100
potget 1 3
expect lastpot 32
midi B0 17 7F
wait 100
potget 0 3
expect lastpot 100
# BOTH: the block (channel 5 = track 5) and the Tonic's channel (the selected track 2)
ccmode 3 0
midi B4 17 5A
midi B9 17 21
wait 100
potget 4 3
expect lastpot 90
potget 1 3
expect lastpot 33
# the block can start higher: base 5 (channels 5-12): channel 5 = track 1
ccmode 2 4
midi B4 17 10
wait 100
potget 0 3
expect lastpot 16
midi B0 17 7F
wait 100
potget 0 3
expect lastpot 16
# the GLO settings list: CC MODE and CC CH BASE sit right after REMOTE MIDI CH (the list starts on TONIC MIDI-less rows: CLOCK OUT 0, NOTES OUT 1,
# TONIC MIDI CH 2, REMOTE MIDI CH 3, CC MODE 4, CC CH BASE 5). OFF -> SELECTED -> CHANNELS -> BOTH, one position per detent
ccmode 0 0
tap GLO
tap GLO
tap GLO
tap GLO
tap GLO
turn SELECT 4
turn ALGO 1
expect ccmode 1
turn ALGO 1
expect ccmode 2
turn ALGO 1
expect ccmode 3
turn ALGO 1
expect ccmode 3
turn SELECT 1
turn ALGO 1
expect ccbase 1
turn ALGO 1
expect ccbase 2
turn ALGO -1
turn ALGO -1
turn ALGO -1
expect ccbase 0
shot cc_settings.png
# back to OFF through the list: nothing arrives any more
turn SELECT -1
turn ALGO -1
turn ALGO -1
turn ALGO -1
expect ccmode 0
# CLASSIC engine (GLO > TONIC ENGINE, row 17 here): the extras (reverb send CC 112 = hex 70, high cut CC 111 = hex 6F) are ignored,
# the 21 parameters work (CC 21 = hex 15, OSC FREQ, pot 1)
tap GLO
tap GLO
tap GLO
tap GLO
tap GLO
turn SELECT 18
turn ALGO 1
expect classic 1
ccmode 2 0
param 0 0 22 0
param 0 0 1 10
midi B0 70 50
midi B0 15 60
wait 100
potget 0 22
expect lastpot 0
potget 0 1
expect lastpot 96
# ... and ENHANCED brings them back
turn ALGO -1
expect classic 0
midi B0 70 50
wait 100
potget 0 22
expect lastpot 80
